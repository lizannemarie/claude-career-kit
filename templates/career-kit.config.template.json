    "{{COMPANY}}",
    "{{LOCATION}}",
    "{{PAY_RANGE_OR_not listed}}",
    "{{ONE_LINE_FIT_NOTE: top two matching strengths, main genuine gap}}",
    "{{DIRECT_URL}}",
    "{{DATE}}"
