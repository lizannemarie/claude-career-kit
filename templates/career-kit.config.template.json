  "split_thresholds": {
    "$comment": "From evals/split-decision (2026-10-15): inline was cheaper and faster at every tested size (email up to 30 threads, job board up to 18 postings) with identical quality. Flows run inline below these sizes; above them (untested) they may fan out to protect the context. Re-run the eval to change them.",
    "email_min_threads": 31,
    "jobboard_min_postings": 19
  }
