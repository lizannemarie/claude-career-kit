  "interface_reporting_dashboard": {
    "interface_name": "Reporting",
    "page_name": "Applications Reporting Dashboard",
    "page_type": "dashboard",
    "note_on_filters": "recordScopeFilters are hard-set per SECTION, so each filtered big-number tile is its own single-element section. Charts/pivot/list share one unfiltered section. Applications with Real Engagement excludes applications whose current state is Application Rejected (matches the author's live dashboard as of 2026-10-19).",
    "sections": [
      {
        "table": "dim_Application",
        "title": "Total Applications Submitted",
        "filter": null,
        "elements": [
          {
            "type": "number",
            "label": "Total Applications Submitted",
            "description": "Since search start",
            "metric": {
              "fieldId": "{dim_Application.Identifier}",
              "aggregation": "countUnique"
            }
          }
        ]
      },
      {
        "table": "dim_Application",
        "title": "Application Stale",
        "filter": {
          "operator": "and",
          "operands": [
            {
              "operator": ">=",
              "operands": [
                "{dim_Application.Days in Current State}",
                14
              ]
            },
            {
              "operator": "doesNotContain",
              "operands": [
                "{dim_Application.Current State}",
                "Rejected"
              ]
            },
            {
              "operator": "doesNotContain",
              "operands": [
                "{dim_Application.Current State}",
                "Offer"
              ]
            }
          ]
        },
        "elements": [
          {
            "type": "number",
            "label": "Application Stale",
            "description": "2+ weeks with no contact",
            "metric": {
              "fieldId": "{dim_Application.Identifier}",
              "aggregation": "countUnique"
            }
          }
        ],
        "dependency": "Days in Current State is a plain number; the email-scrub task must refresh it daily (see scheduled-tasks/email-scrub STEP 4b) or this tile never fires."
      },
      {
        "table": "dim_Application",
        "title": "Rejected Application",
        "filter": {
          "operands": [
            {
              "operator": "contains",
              "operands": [
                "{dim_Application.Current State}",
                "Application Rejected"
              ]
            }
          ]
        },
        "elements": [
          {
            "type": "number",
            "label": "Rejected Application",
            "description": "Blame the bots",
            "metric": {
              "fieldId": "{dim_Application.Identifier}",
              "aggregation": "countUnique"
            }
          }
        ]
      },
      {
        "table": "dim_Application",
        "title": "Applications with Real Engagement",
        "filter": {
          "operator": "and",
          "operands": [
            {
              "operator": "or",
              "operands": [
                {
                  "operator": "contains",
                  "operands": [
                    "{dim_Application.All States}",
                    "Recruiter Contact"
                  ]
                },
                {
                  "operator": "contains",
                  "operands": [
                    "{dim_Application.All States}",
                    "Formal Interview"
                  ]
                }
              ]
            },
            {
              "operator": "doesNotContain",
              "operands": [
                "{dim_Application.Current State}",
                "Application Rejected"
              ]
            }
          ]
        },
        "elements": [
          {
            "type": "number",
            "label": "Applications with Real Engagement",
            "description": "Human Contact Made",
            "metric": {
              "fieldId": "{dim_Application.Identifier}",
              "aggregation": "countUnique"
            }
          }
        ]
      },
      {
        "table": "dim_Application",
        "title": "Interview Loops",
        "filter": {
          "operands": [
            {
              "operator": "contains",
              "operands": [
                "{dim_Application.All States}",
                "Formal Interview"
              ]
            }
          ]
        },
        "elements": [
          {
            "type": "number",
            "label": "Interview Loops",
            "description": "Please love me",
            "metric": {
              "fieldId": "{dim_Application.Identifier}",
              "aggregation": "count"
            }
          }
        ]
      },
      {
        "table": "dim_Application",
        "title": "Interview Rejected",
        "filter": {
          "operands": [
            {
              "operator": "contains",
              "operands": [
                "{dim_Application.Current State}",
                "Interview Rejected"
              ]
            }
          ]
        },
        "elements": [
          {
            "type": "number",
            "label": "Interview Rejected",
            "description": "I didn't want that job anyway",
            "metric": {
              "fieldId": "{dim_Application.Identifier}",
              "aggregation": "countUnique"
            }
          }
        ]
      },
      {
        "table": "dim_Application",
        "title": "Pipeline breakdown",
        "filter": null,
        "elements": [
          {
            "type": "barChart",
            "title": "Applications by Current State",
            "xAxisFieldId": "{dim_Application.Current State}",
            "aggregation": "recordCount",
            "description": "Total applications grouped by each pipeline stage to identify bottlenecks."
          },
          {
            "type": "barChart",
            "title": "Company Charting",
            "xAxisFieldId": "{dim_Application.Company}",
            "aggregation": {
              "fieldId": "{dim_Application.Identifier}",
              "function": "distinct"
            }
          },
          {
            "type": "barChart",
            "title": "Average Emails per Application by Current State",
            "xAxisFieldId": "{dim_Application.Current State}",
            "aggregation": {
              "fieldId": "{dim_Application.Count Emails}",
              "function": "average"
            },
            "description": "Shows the average number of emails exchanged per application for each current state to highlight applicant engagement levels at different stages."
          },
          {
            "type": "pivotTable",
            "title": "Applications by State and Company",
            "rowDimension": {
              "fieldId": "{dim_Application.Current State}",
              "sort": {
                "type": "group",
                "order": "ascending"
              },
              "showTotals": true
            },
            "columnDimension": {
              "fieldId": "{dim_Application.Company}",
              "sort": {
                "type": "value",
                "order": "descending"
              },
              "showTotals": false
            },
            "summary": {
              "fieldId": "{dim_Application.Identifier}",
              "function": "countUnique"
            },
            "description": "Count of applications by current state and company. Use it to see which companies are engaging and where applications stall."
          },
          {
            "type": "list",
            "title": "Applications by Current State",
            "hierarchyLevels": {
              "level1": {
                "tableId": "{dim_Application}",
                "fieldIds": [
                  "{dim_Application.Identifier}",
                  "{dim_Application.Location}",
                  "{dim_Application.Flexible Work}",
                  "{dim_Application.Count Emails}",
                  "{dim_Application.Current State}"
                ]
              }
            }
          }
        ]
      }
    ],
    "after_create": "publish_interface, then read back with list_pages_for_base and verify each tile with list_records_for_page(elementId): a freshly created base returns 0 for every filtered tile, which is expected."
  },
