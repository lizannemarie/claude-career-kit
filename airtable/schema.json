  "phase3_derived": [
    {
      "table": "dim_Company",
      "name": "Count Applications",
      "type": "count",
      "recordLinkField": "dim_Application"
    },
    {
      "table": "dim_Application",
      "name": "Name (from Company)",
      "type": "multipleLookupValues",
      "recordLinkField": "Company",
      "lookup": "dim_Company.Name"
    },
    {
      "table": "dim_Application",
      "name": "Company Size (from Company)",
      "type": "multipleLookupValues",
      "recordLinkField": "Company",
      "lookup": "dim_Company.Company Size"
    },
    {
      "table": "dim_Application",
      "name": "Glass Door Rating (from Company)",
      "type": "multipleLookupValues",
      "recordLinkField": "Company",
      "lookup": "dim_Company.Glass Door Rating"
    },
    {
      "table": "dim_Application",
      "name": "Name (from Resume Used)",
      "type": "multipleLookupValues",
      "recordLinkField": "Resume Used",
      "lookup": "dim_Resume.Name"
    },
    {
      "table": "dim_Application",
      "name": "Attachments (from Resume Used)",
      "type": "multipleLookupValues",
      "recordLinkField": "Resume Used",
      "lookup": "dim_Resume.Attachments"
    },
    {
      "table": "dim_Application",
      "name": "Count Emails",
      "type": "count",
      "recordLinkField": "fact_email"
    },
    {
      "table": "dim_Application",
      "name": "Latest Date",
      "type": "rollup",
      "recordLinkField": "fact_email",
      "rollupField": "fact_email.Received",
      "formula": "MAX(values)",
      "note": "API reports result type 'date' (display only); the stored value keeps the time and IsLatest's minute-level compare works - verified on test data"
    },
    {
      "table": "dim_Application",
      "name": "First Date",
      "type": "rollup",
      "recordLinkField": "fact_email",
      "rollupField": "fact_email.Received",
      "formula": "MIN(values)"
    },
    {
      "table": "dim_Application",
      "name": "All States",
      "type": "rollup",
      "recordLinkField": "fact_email",
      "rollupField": "fact_email.Email Context",
      "formula": "ARRAYUNIQUE(values)"
    },
    {
      "table": "fact_email",
      "name": "Latest Date (from Application)",
      "type": "multipleLookupValues",
      "recordLinkField": "Application",
      "lookup": "dim_Application.Latest Date"
    },
    {
      "table": "fact_email",
      "name": "First Date (from Application)",
      "type": "multipleLookupValues",
      "recordLinkField": "Application",
      "lookup": "dim_Application.First Date"
    },
    {
      "table": "fact_email",
      "name": "Identifier (from Application)",
      "type": "multipleLookupValues",
      "recordLinkField": "Application",
      "lookup": "dim_Application.Identifier"
    },
    {
      "table": "fact_email",
      "name": "Job Title (from Application)",
      "type": "multipleLookupValues",
      "recordLinkField": "Application",
      "lookup": "dim_Application.Job Title"
    },
    {
      "table": "dim_Company",
      "name": "Attachment Summary",
      "type": "aiText",
      "prompt": [
        "Summarize these attachments: ",
        {
          "field": "Attachments"
        }
      ],
      "description": "An AI generated summary of the Attachments field. Upload files to Attachments to generate a summary.",
      "note": "cells generate on demand in the Airtable UI"
    },
    {
      "table": "fact_email",
      "name": "Attachment Summary",
      "type": "aiText",
      "prompt": [
        "Summarize these attachments: ",
        {
          "field": "Attachments"
        }
      ],
      "description": "An AI generated summary of the Attachments field. Upload files to Attachments to generate a summary."
    },
    {
      "table": "dim_Resume",
      "name": "Attachment Summary",
      "type": "aiText",
      "prompt": [
        "Summarize these attachments: ",
        {
          "field": "Attachments"
        }
      ],
      "description": "An AI generated summary of the Attachments field. Upload files to Attachments to generate a summary."
    }
  ],
  "phase4_formulas": [
    {
      "table": "fact_email",
      "name": "IsLatest",
      "type": "formula",
      "description": "Checks if the Received date matches the Latest Date from Application.",
      "formula": "IF(ISERROR( IS_SAME({Received}, {Latest Date (from Application)}, 'minute')),IF({Email Context}=\"Application Rejected\",1,IS_SAME({Received}, {Latest Date (from Application)}, 'minute')),IS_SAME({Received}, {Latest Date (from Application)}, 'minute'))",
      "note": "identical to the source base; referenced by field name here, the API rewrites to IDs"
    },
    {
      "table": "fact_email",
      "name": "Latest Context",
      "type": "formula",
      "description": "Helper (career-kit): Email Context only on the newest email of an application; feeds dim_Application.Current State.",
      "formula": "IF({IsLatest}=1,{Email Context},BLANK())",
      "deviation_from_source": "NEW helper field. In the source base 'Current State' is a conditional rollup (filtered to the latest email). The Airtable API cannot create rollup filters, so the kit reproduces the same result with this helper. Result verified: 2 same-day emails -> Current State = ['Formal Interview']."
    },
    {
      "table": "dim_Application",
      "name": "Current State",
      "type": "rollup",
      "recordLinkField": "fact_email",
      "rollupField": "fact_email.Latest Context",
      "formula": "ARRAYUNIQUE(ARRAYCOMPACT(values))",
      "warning": "Create with ARRAYCOMPACT on the first try: rollup formulas cannot be edited through the API afterwards (update_field only edits formula fields) and fields cannot be deleted through the connector."
    }
  ],
  "optional_extension_fact_interview": {
